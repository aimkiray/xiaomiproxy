#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# homeproxy CLI -- manage HomeProxy on LuCI-less routers (MiWiFi).
# Usage: homeproxy <command> [args]
#   start|stop|restart|reload|status   service control
#   enable|disable                     boot autostart
#   generate                           regenerate sing-box configs
#   migrate                             apply config defaults/migration
#   subscribe                          update subscriptions now
#   update-resources [all|china_ip4|china_ip6|gfw_list|china_list]
#   nodes                              list proxy nodes
#   node <name>                         show one node
#   main-node [name|urltest|nil]        get/set main node
#   routing-mode [mode]                get/set routing_mode
#   proxy-mode [mode]                  get/set proxy_mode
#   lan-proxy [mode]                    get/set lan_proxy_mode
#   add <label> -- <type> <addr> <port> [key=val ...]
#   del <name>                          delete a node
#   set <section.option> <value>       set a uci option
#   get <section.option>                get a uci option
#   show                               dump the whole config
#   log [-f]                            show / tail the log

CONF=homeproxy
INIT=/etc/init.d/$CONF
[ -f /etc/homeproxy/env.sh ] && . /etc/homeproxy/env.sh || true
LUA_DIR="${HP_LIB_DIR:-/usr/lib/homeproxy}"
export HP_LUAPATH="$LUA_DIR"
HP_DIR=/etc/homeproxy
RUN_DIR=/var/run/homeproxy
LOG_PATH=$RUN_DIR/$CONF.log

die() { echo "homeproxy: $*" >&2; exit 1; }
uci_set() { uci set "$CONF.$1=$2" 2>/dev/null && uci commit "$CONF"; }
uci_get() { uci -q get "$CONF.$1" 2>/dev/null; }

# Section type check: node_exists <name> -> 0 iff homeproxy.<name> is a node.
node_exists() {
    [ "$(uci -q show "$CONF.$1" 2>/dev/null | awk -F= 'NR==1{print $2}')" = "node" ]
}

# True when $1 (a node section name) is still referenced by config options that
# would dangle if it were deleted. Prints the first referrer found.
node_referenced() {
    local n="$1" ref
    for ref in "config.main_node" "config.main_udp_node"; do
        [ "$(uci_get "$ref")" = "$n" ] && { echo "$ref"; return 0; }
    done
    # uci show renders scalars as key='name' and lists as key='a' 'name' 'b';
    # the name always appears quote-wrapped, so an exact-quoted match suffices.
    uci -q show "$CONF" 2>/dev/null | grep -qF "'$n'" && {
        echo "urltest/routing/dns reference"; return 0; }
    return 1
}

cmd_status() {
    pgrep -f "sing-box run --config $RUN_DIR/sing-box" >/dev/null 2>&1 \
        && echo "running" || echo "stopped"
}

cmd_nodes() {
    echo "NAME                                LABEL                      TYPE        ADDRESS:PORT"
    # Collect fields per section and print on the next section boundary: uci
    # option order is not stable (subscription writes use pairs()), so a row
    # is only complete once the section ends. Values may contain '=' so the
    # split is on the FIRST '=' only.
    uci -q show "$CONF" 2>/dev/null | awk '
        function pr() {
            gsub(/^[ \x27]+|[ \x27]+$/,"",label); gsub(/^[ \x27]+|[ \x27]+$/,"",type)
            gsub(/^[ \x27]+|[ \x27]+$/,"",addr);   gsub(/^[ \x27]+|[ \x27]+$/,"",port)
            printf "%-36s %-26s %-11s %s:%s\n", name, label, type, addr, port
        }
        /^homeproxy\.[^.=]+=[^ \x27]+$/ {           # any section-type line
            if (name != "") pr()
            if ($0 ~ /=node$/) { name=$1; sub(/^homeproxy\./,"",name); sub(/=.*$/,"",name) } else name=""
            label=type=addr=port=""; next
        }
        name != "" {
            val=$0; sub(/^[^=]*=/,"",val)
            # Anchor on the section prefix: ".label=" inside a VALUE must
            # not be mistaken for the option name.
            if ($0 ~ /^homeproxy\.[^.]+\.label=/) label=val
            else if ($0 ~ /^homeproxy\.[^.]+\.type=/) type=val
            else if ($0 ~ /^homeproxy\.[^.]+\.address=/) addr=val
            else if ($0 ~ /^homeproxy\.[^.]+\.port=/) port=val
        }
        END { if (name != "") pr() }
    '
}

cmd_add() {
    local label="" rest=0 type addr port name
    while [ $# -gt 0 ]; do
        if [ "$1" = "--" ]; then rest=1; shift; break; fi
        [ -z "$label" ] && label="$1"; shift
    done
    [ "$rest" = "1" ] && [ $# -ge 3 ] || die "usage: homeproxy add <label> -- <type> <addr> <port> [key=val ...]"
    [ -n "$label" ] || die "add: a label is required"
    type="$1"; addr="$2"; port="$3"; shift 3
    # sing-box has no shadowsocksr support; keep the list aligned with what
    # subscription_parser.lua can produce and the generator can emit.
    case "$type" in
        shadowsocks|vless|vmess|trojan|hysteria|hysteria2|tuic|anytls|socks|http|wireguard) ;;
        *) die "unsupported node type: $type" ;;
    esac
    case "$port" in ''|*[!0-9]*) die "invalid port: $port" ;; esac
    [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || die "port out of range: $port"
    name="$(printf '%s' "$label" | md5sum | cut -c1-32)"
    uci set "$CONF.$name=node" || die "failed to create node section"
    uci set "$CONF.$name.label=$label" || die "uci set label failed"
    uci set "$CONF.$name.type=$type" || die "uci set type failed"
    uci set "$CONF.$name.address=$addr" || die "uci set address failed"
    uci set "$CONF.$name.port=$port" || die "uci set port failed"
    for kv in "$@"; do
        case "$kv" in
            # Reserved keys would override the validated fields above.
            label=*|type=*|address=*|port=*)
                die "add: '$kv' duplicates a positional argument" ;;
            [a-zA-Z0-9_]*=*) uci set "$CONF.$name.$kv" || die "uci set failed: $kv" ;;
            *) echo "homeproxy: ignoring bad key=val '$kv'" >&2 ;;
        esac
    done
    uci commit "$CONF" || die "commit failed"
    echo "Added node '$label' as section $name. Run 'homeproxy generate' then restart."
}

cmd_del() {
    [ -n "$1" ] || die "usage: homeproxy del <name>"
    # Refuse non-node sections (config/infra/dns_server/...): deleting one
    # breaks generation entirely.
    node_exists "$1" || die "no such node (or not a node section): $1"
    local ref
    ref=$(node_referenced "$1")
    case "$ref" in
        config.main_node|config.main_udp_node)
            die "node $1 is still set as $ref -- set another node first" ;;
        "")
            : ;;
        *)
            echo "warning: $1 is still referenced by $ref" >&2 ;;
    esac
    uci delete "$CONF.$1" 2>/dev/null || die "delete failed: $1"
    uci commit "$CONF" || die "commit failed"
    echo "Deleted node $1."
}

cmd_set() {
    [ $# -ge 2 ] || die "usage: homeproxy set <section.option> <value>"
    local key="$1"; shift
    case "$key" in *.*) ;; *) die "key must be <section.option>" ;; esac
    # Validate the enum options that have dedicated commands -- a bad value
    # here breaks generation or silently changes steering semantics. Other
    # keys pass through as a raw escape hatch.
    case "$key" in
        config.routing_mode)
            case "$*" in bypass_mainland_china|proxy_mainland_china|gfwlist|global|custom) ;;
                *) die "bad routing_mode: $*" ;; esac ;;
        config.proxy_mode)
            case "$*" in redirect|tproxy|redirect_tproxy|redirect_tun|tun|tproxy_tun) ;;
                *) die "bad proxy_mode: $*" ;; esac ;;
        control.lan_proxy_mode)
            case "$*" in disabled|only_proxy|listed_only|except_listed) ;;
                *) die "bad lan_proxy_mode: $*" ;; esac ;;
        config.main_node)
            case "$*" in urltest|nil) ;; *)
                node_exists "$*" || die "no such node: $*" ;; esac ;;
        config.main_udp_node)
            case "$*" in urltest|nil|same) ;; *)
                node_exists "$*" || die "no such node: $*" ;; esac ;;
    esac
    uci_set "$key" "$*" || die "uci set failed: $key"
    echo "Set $key = $*"
}
cmd_get() { [ -n "$1" ] || die "usage: homeproxy get <section.option>"; uci_get "$1"; }

case "$1" in
start|stop|restart|reload) "$INIT" "$@" ;;
status) cmd_status ;;
enable) "$INIT" enable && echo "Enabled $CONF at boot." ;;
disable) "$INIT" disable && echo "Disabled $CONF at boot." ;;
generate)
    mkdir -p "$RUN_DIR"
    lua "$LUA_DIR/migrate_config.lua" || die "migrate failed"
    gen_c=0; gen_s=0
    # In custom routing mode the client config is needed even with main_node
    # unset: routing rules point at nodes directly.
    if [ "$(uci -q get $CONF.config.main_node)" != "nil" ] || [ "$(uci -q get $CONF.config.routing_mode)" = "custom" ]; then
        lua "$LUA_DIR/generate_client.lua" || die "client generation failed"
        gen_c=1
    fi
    if [ "$(uci -q get $CONF.server.enabled)" = "1" ]; then
        lua "$LUA_DIR/generate_server.lua" || die "server generation failed"
        gen_s=1
    fi
    # Validate with sing-box when available so a bad config is caught here,
    # not at the next service start. Only files generated in THIS run are
    # checked -- a stale sing-box-s.json from a now-disabled server must not
    # fail the command.
    SB=${HP_SINGBOX:-/usr/bin/sing-box}
    [ -x "$SB" ] || SB=$(command -v sing-box 2>/dev/null || true)
    if [ -n "$SB" ]; then
        [ "$gen_c" = "1" ] && { [ -f "$RUN_DIR/sing-box-c.json" ] || die "sing-box-c.json missing after generation"; "$SB" check --config "$RUN_DIR/sing-box-c.json" || die "sing-box check failed: sing-box-c.json"; }
        [ "$gen_s" = "1" ] && { [ -f "$RUN_DIR/sing-box-s.json" ] || die "sing-box-s.json missing after generation"; "$SB" check --config "$RUN_DIR/sing-box-s.json" || die "sing-box check failed: sing-box-s.json"; }
    fi
    echo "Configs generated in $RUN_DIR."
    ;;
migrate) lua "$LUA_DIR/migrate_config.lua" && echo "Migration applied." ;;
# Run the node-name migration first: an update fired between a package
# upgrade and the first service start would otherwise see only old-style
# section names and rebuild every node (losing the selected main_node).
subscribe) lua "$LUA_DIR/migrate_config.lua" || die "migrate failed"; lua "$LUA_DIR/update_subscriptions.lua" ;;
update-resources)
    shift
    if [ -z "$1" ] || [ "$1" = "all" ]; then
        for i in china_ip4 china_ip6 gfw_list china_list; do "$HP_DIR/scripts/update_resources.sh" "$i"; done
    else "$HP_DIR/scripts/update_resources.sh" "$1"; fi
    ;;
nodes) cmd_nodes ;;
node) [ -n "$2" ] || die "usage: homeproxy node <name>"; uci -q show "$CONF.$2" 2>/dev/null || die "no such section: $2" ;;
main-node)
    if [ -z "$2" ]; then uci_get "config.main_node"; else
        case "$2" in urltest|nil) ;; *) node_exists "$2" || die "no such node: $2" ;; esac
        uci_set "config.main_node" "$2" || die "set failed"; echo "main_node=$2"
    fi ;;
routing-mode)
    if [ -z "$2" ]; then uci_get "config.routing_mode"; else
        case "$2" in bypass_mainland_china|proxy_mainland_china|gfwlist|global|custom) ;; *) die "bad routing_mode: $2 (bypass_mainland_china|proxy_mainland_china|gfwlist|global|custom)" ;; esac
        uci_set "config.routing_mode" "$2" || die "set failed"; echo "routing_mode=$2"
    fi ;;
proxy-mode)
    if [ -z "$2" ]; then uci_get "config.proxy_mode"; else
        case "$2" in redirect|tproxy|redirect_tproxy|redirect_tun|tun|tproxy_tun) ;; *) die "bad proxy_mode: $2 (redirect|tproxy|redirect_tproxy|redirect_tun|tun|tproxy_tun)" ;; esac
        uci_set "config.proxy_mode" "$2" || die "set failed"; echo "proxy_mode=$2"
    fi ;;
lan-proxy)
    if [ -z "$2" ]; then uci_get "control.lan_proxy_mode"; else
        # Same value set as the web UI / API / firewall gate.
        case "$2" in disabled|only_proxy|listed_only|except_listed) ;; *) die "bad lan_proxy_mode: $2 (disabled|only_proxy|listed_only|except_listed)" ;; esac
        uci_set "control.lan_proxy_mode" "$2" || die "set failed"; echo "lan_proxy_mode=$2"
    fi ;;
add) shift; cmd_add "$@" ;;
del) cmd_del "$2" ;;
set) shift; cmd_set "$@" ;;
get) cmd_get "$2" ;;
show) uci -q show "$CONF" ;;
log) if [ "$2" = "-f" ]; then tail -F "$LOG_PATH" 2>/dev/null || echo "no log yet"; else tail -n 50 "$LOG_PATH" 2>/dev/null || echo "no log yet"; fi ;;
""|-h|--help|help) sed -n '4,23p' "$0" 2>/dev/null ;;
*) die "unknown command '$1' (try: homeproxy help)" ;;
esac