#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
#
# HomeProxy init script (MiWiFi port): runs sing-box via procd, generates
# configs with the on-device lua, and steers traffic with iptables+ipset.

USE_PROCD=1

START=99
STOP=10

CONF="homeproxy"
HP_DIR="/etc/homeproxy"
[ -f /etc/homeproxy/env.sh ] && . /etc/homeproxy/env.sh || true
HP_LUA_DIR="${HP_LIB_DIR:-/usr/lib/homeproxy}"
export HP_LUAPATH="$HP_LUA_DIR"
RUN_DIR="/var/run/homeproxy"
LOG_PATH="$RUN_DIR/homeproxy.log"

PROG="${HP_SINGBOX:-$(command -v sing-box 2>/dev/null)}"
[ -n "$PROG" ] || PROG="/usr/bin/sing-box"

log() {
    echo -e "$(date "+%Y-%m-%d %H:%M:%S") [DAEMON] $*" >> "$LOG_PATH"
}

start_service() {
    config_load "$CONF"

    local routing_mode proxy_mode
    config_get routing_mode "config" "routing_mode" "bypass_mainland_china"
    config_get proxy_mode "config" "proxy_mode" "redirect_tproxy"

    local outbound_node
    if [ "$routing_mode" != "custom" ]; then
        config_get outbound_node "config" "main_node" "nil"
    else
        config_get outbound_node "routing" "default_outbound" "nil"
    fi

    local server_enabled
    config_get_bool server_enabled "server" "enabled" "0"

    if [ "$outbound_node" = "nil" ] && [ "$server_enabled" = "0" ]; then
        return 1
    fi

    mkdir -p "$RUN_DIR"

    # one-shot migration / defaults (check exit status — M4)
    if ! lua "$HP_LUA_DIR/migrate_config.lua" 2>>"$LOG_PATH"; then
        log "Warning: config migration failed (continuing with current config)."
    fi

    if [ "$outbound_node" != "nil" ]; then
        lua "$HP_LUA_DIR/generate_client.lua" 2>>"$LOG_PATH"
        if [ ! -e "$RUN_DIR/sing-box-c.json" ]; then
            log "Error: failed to generate client configuration."
            return 1
        elif ! "$PROG" check --config "$RUN_DIR/sing-box-c.json" 2>>"$LOG_PATH"; then
            # A bad *unused* node (now materialized as a probe outbound for the
            # web UI per-node ping) can fail the whole-config check. Retry
            # without the probe outbounds so a single malformed node never
            # blocks startup; ping-all is simply unavailable for that run.
            log "Config check failed; retrying without per-node probe outbounds..."
            HP_MATERIALIZE_ALL_NODES=0 lua "$HP_LUA_DIR/generate_client.lua" 2>>"$LOG_PATH"
            if [ ! -e "$RUN_DIR/sing-box-c.json" ] || ! "$PROG" check --config "$RUN_DIR/sing-box-c.json" 2>>"$LOG_PATH"; then
                log "Error: wrong client configuration detected."
                return 1
            fi
            log "Config OK after disabling per-node probe outbounds (ping-all unavailable this run)."
        fi

        # Config validated — now safe to mutate routing/firewall state (H9).
        # Generate + validate server config too, so a server config failure
        # doesn't leave client routing/tun/cron state half-applied.
        local server_cfg_ok=1
        if [ "$server_enabled" = "1" ]; then
            lua "$HP_LUA_DIR/generate_server.lua" 2>>"$LOG_PATH"
            if [ ! -e "$RUN_DIR/sing-box-s.json" ]; then
                log "Error: failed to generate server configuration."
                return 1
            elif ! "$PROG" check --config "$RUN_DIR/sing-box-s.json" 2>>"$LOG_PATH"; then
                log "Error: wrong server configuration detected."
                return 1
            fi
        fi

        # auto subscription update
        local auto_update auto_update_time
        config_get_bool auto_update "subscription" "auto_update" "0"
        if [ "$auto_update" = "1" ]; then
            config_get auto_update_time "subscription" "auto_update_time" "2"
            # Validate: must be a single integer 0-23 (H12: prevent command
            # injection via UCI value written into crontab).
            case "$auto_update_time" in
                ''|*[!0-9]*) auto_update_time="2" ;;
                *)
                    [ "$auto_update_time" -ge 0 ] 2>/dev/null && [ "$auto_update_time" -le 23 ] 2>/dev/null || auto_update_time="2" ;;
            esac
            sed -i "/#${CONF}_autosetup/d" "/etc/crontabs/root" 2>/dev/null
            echo "0 $auto_update_time * * * $HP_DIR/scripts/update_crond.sh #${CONF}_autosetup" >> "/etc/crontabs/root"
            /etc/init.d/cron restart >/dev/null 2>&1
        fi

        # routing table for tproxy / tun
        local table_mark
        config_get table_mark "infra" "table_mark" "100"
        local ipv6_support
        config_get_bool ipv6_support "config" "ipv6_support" "0"
        case "$proxy_mode" in
        *"tproxy"*)
            local outbound_udp_node tproxy_mark
            config_get outbound_udp_node "config" "main_udp_node" "nil"
            config_get tproxy_mark "infra" "tproxy_mark" "101"
            if [ "$outbound_udp_node" != "nil" ] || [ "$routing_mode" = "custom" ]; then
                ip rule add fwmark "$tproxy_mark" table "$table_mark" 2>/dev/null
                ip route add local 0.0.0.0/0 dev lo table "$table_mark" 2>/dev/null
                if [ "$ipv6_support" = "1" ]; then
                    ip -6 rule add fwmark "$tproxy_mark" table "$table_mark" 2>/dev/null
                    ip -6 route add local ::/0 dev lo table "$table_mark" 2>/dev/null
                fi
            fi
            ;;
        *"tun"*)
            local tun_name tun_mark
            config_get tun_name "infra" "tun_name" "singtun0"
            config_get tun_mark "infra" "tun_mark" "102"
            ip tuntap add mode tun user root name "$tun_name" 2>/dev/null
            sleep 1
            ip link set "$tun_name" up 2>/dev/null
            ip route replace default dev "$tun_name" table "$table_mark" 2>/dev/null
            ip rule add fwmark "$tun_mark" lookup "$table_mark" 2>/dev/null
            [ "$ipv6_support" = "1" ] && {
                ip -6 route replace default dev "$tun_name" table "$table_mark" 2>/dev/null
                ip -6 rule add fwmark "$tun_mark" lookup "$table_mark" 2>/dev/null
            }
            ;;
        esac

        # sing-box (client)
        [ -e "$RUN_DIR/sing-box-c.log" ] && : > "$RUN_DIR/sing-box-c.log"
        procd_open_instance "sing-box-c"
        procd_set_param command "$PROG"
        procd_append_param command run --config "$RUN_DIR/sing-box-c.json"
        uname -r | grep -Eq "^6\.6" && procd_set_param env "QUIC_GO_DISABLE_GSO"="true"
        procd_set_param limits core="unlimited"
        procd_set_param limits nofile="1000000 1000000"
        procd_set_param stderr 1
        procd_set_param stdout 1
        procd_set_param respawn ${respawn_threshold:-360} ${respawn_timeout:-5} ${respawn_retry:-5}
        procd_set_param term_timeout 15
        procd_close_instance
    fi

    if [ "$server_enabled" = "1" ]; then
        [ -e "$RUN_DIR/sing-box-s.log" ] && : > "$RUN_DIR/sing-box-s.log"
        procd_open_instance "sing-box-s"
        procd_set_param command "$PROG"
        procd_append_param command run --config "$RUN_DIR/sing-box-s.json"
        uname -r | grep -Eq "^6\.6" && procd_set_param env "QUIC_GO_DISABLE_GSO"="true"
        procd_set_param limits core="unlimited"
        procd_set_param limits nofile="1000000 1000000"
        procd_set_param stderr 1
        procd_set_param stdout 1
        procd_set_param respawn ${respawn_threshold:-360} ${respawn_timeout:-5} ${respawn_retry:-5}
        procd_set_param term_timeout 15
        procd_close_instance
    fi

    # log-cleaner
    procd_open_instance "log-cleaner"
    procd_set_param command "$HP_DIR/scripts/clean_log.sh"
    procd_set_param respawn
    procd_close_instance

    case "$routing_mode" in
    "bypass_mainland_china") [ -e "$RUN_DIR/cache.db" ] || touch "$RUN_DIR/cache.db" ;;
    "custom") [ -d "$HP_DIR/ruleset" ] || mkdir -p "$HP_DIR/ruleset" ;;
    esac

    [ "$server_enabled" = "1" ] && mkdir -p "$HP_DIR/certs"

    # firewall (iptables+ipset)
    if sh "$HP_LUA_DIR/firewall.sh" start 2>>"$LOG_PATH"; then
        [ "$lan_proxy_mode" != "disabled" ] && : > "$RUN_DIR/firewall.active"
    else
        log "Error: firewall.sh failed; firewall rules not applied."
    fi

    # DNS steering via dnsmasq conf-dir (mirrors upstream init.homeproxy):
    # dnsmasq forwards selected domains to sing-box DNS (infra.dns_port) and,
    # where needed, populates an ipset the firewall matches against. The
    # firewall.sh run above already created those ipsets.
    if [ "$outbound_node" != "nil" ]; then
        local hp_ipv6 hp_dns_port gfw_v6="" wan_v6="" wan_direct_v6=""
        config_get_bool hp_ipv6 "config" "ipv6_support" "0"
        config_get hp_dns_port "infra" "dns_port" "5333"
        [ "$hp_ipv6" = "1" ] && { gfw_v6=",homeproxy_gfw6"; wan_v6=",homeproxy_wan_proxy6"; wan_direct_v6=",homeproxy_wan_direct6"; }
        mkdir -p /tmp/dnsmasq.d
        case "$routing_mode" in
        "bypass_mainland_china"|"custom"|"global")
            # forward ALL queries to sing-box DNS; sing-box splits CN/non-CN.
            printf 'no-poll\nno-resolv\nserver=127.0.0.1#%s\n' "$hp_dns_port" > /tmp/dnsmasq.d/homeproxy_redirect_dns.conf
            ;;
        "gfwlist")
            if [ -s "$HP_DIR/resources/gfw_list.txt" ]; then
                awk -v dp="$hp_dns_port" -v v6="$gfw_v6" \
                    '{sub(/^[ \t\r]+/,"");sub(/[ \t\r]+$/,"")} !NF||/^#/||$0!~/^[A-Za-z0-9._-]+$/ {next} {print "server=/"$0"/127.0.0.1#"dp; print "ipset=/"$0"/homeproxy_gfw4"v6}' \
                    "$HP_DIR/resources/gfw_list.txt" > /tmp/dnsmasq.d/homeproxy_gfw.conf
            else
                log "Warning: gfw_list.txt missing -- gfwlist mode will not split traffic."
            fi
            ;;
        "proxy_mainland_china")
            if [ -s "$HP_DIR/resources/china_list.txt" ]; then
                awk -v dp="$hp_dns_port" \
                    '{sub(/^[ \t\r]+/,"");sub(/[ \t\r]+$/,"")} !NF||/^#/||$0!~/^[A-Za-z0-9._-]+$/ {next} {print "server=/"$0"/127.0.0.1#"dp}' \
                    "$HP_DIR/resources/china_list.txt" > /tmp/dnsmasq.d/homeproxy_china_list.conf
            else
                log "Warning: china_list.txt missing -- proxy_mainland_china DNS not split."
            fi
            ;;
        esac
        # proxy_list.txt: always-proxy domains -> sing-box DNS + wan_proxy ipset.
        if [ "$routing_mode" != "custom" ] && [ -s "$HP_DIR/resources/proxy_list.txt" ]; then
            awk -v dp="$hp_dns_port" -v v6="$wan_v6" \
                '{sub(/^[ \t\r]+/,"");sub(/[ \t\r]+$/,"")} !NF||/^#/||$0!~/^[A-Za-z0-9._-]+$/ {next} {print "server=/"$0"/127.0.0.1#"dp; print "ipset=/"$0"/homeproxy_wan_proxy4"v6}' \
                "$HP_DIR/resources/proxy_list.txt" > /tmp/dnsmasq.d/homeproxy_proxy_list.conf
        fi
        # direct_list.txt: always-direct domains -> add to wan_direct ipset so the
        # firewall steers them direct (RETURN) regardless of routing mode. No
        # server= redirect: let them resolve normally and force-direct by ipset.
        if [ "$routing_mode" != "custom" ] && [ -s "$HP_DIR/resources/direct_list.txt" ]; then
            awk -v v6="$wan_direct_v6" \
                '{sub(/^[ \t\r]+/,"");sub(/[ \t\r]+$/,"")} !NF||/^#/||$0!~/^[A-Za-z0-9._-]+$/ {next} {print "ipset=/"$0"/homeproxy_wan_direct4"v6}' \
                "$HP_DIR/resources/direct_list.txt" > /tmp/dnsmasq.d/homeproxy_direct_list.conf
        fi
        /etc/init.d/dnsmasq restart >/dev/null 2>&1
    fi

    log "HomeProxy started (sing-box: $("$PROG" version -n 2>/dev/null | head -1))."
}

stop_service() {
    # Only remove the cron entry if it actually exists (avoid unnecessary cron restart).
    if grep -q "#${CONF}_autosetup" /etc/crontabs/root 2>/dev/null; then
        sed -i "/#${CONF}_autosetup/d" "/etc/crontabs/root" 2>/dev/null
        /etc/init.d/cron restart >/dev/null 2>&1
    fi

    sh "$HP_LUA_DIR/firewall.sh" stop 2>>"$LOG_PATH"
    rm -f "$RUN_DIR/firewall.active"

    # remove dnsmasq DNS steering (any routing mode)
    if ls /tmp/dnsmasq.d/homeproxy_*.conf >/dev/null 2>&1; then
        rm -f /tmp/dnsmasq.d/homeproxy_*.conf
        /etc/init.d/dnsmasq restart >/dev/null 2>&1
    fi

    local table_mark
    config_load "$CONF"
    config_get table_mark "infra" "table_mark" "100"
    local tproxy_mark tun_mark
    config_get tproxy_mark "infra" "tproxy_mark" "101"
    config_get tun_mark "infra" "tun_mark" "102"
    # Drain duplicate ip rules (from race conditions / double-start).
    while ip rule del fwmark "$tproxy_mark" table "$table_mark" 2>/dev/null; do :; done
    ip route del local 0.0.0.0/0 dev lo table "$table_mark" 2>/dev/null
    while ip -6 rule del fwmark "$tproxy_mark" table "$table_mark" 2>/dev/null; do :; done
    ip -6 route del local ::/0 dev lo table "$table_mark" 2>/dev/null
    while ip rule del fwmark "$tun_mark" lookup "$table_mark" 2>/dev/null; do :; done

    # Tear down the tun device (H10: was only in service_stopped, which is not
    # called from reload_service's stop).
    local tun_name
    config_get tun_name "infra" "tun_name" "singtun0"
    ip link set "$tun_name" down 2>/dev/null
    ip tuntap del mode tun name "$tun_name" 2>/dev/null

    rm -f "$RUN_DIR/sing-box-c.json" "$RUN_DIR/sing-box-c.log" \
          "$RUN_DIR/sing-box-s.json" "$RUN_DIR/sing-box-s.log"

    log "Service stopped."
}

service_stopped() {
    config_load "$CONF"
    local tun_name
    config_get tun_name "infra" "tun_name" "singtun0"
    ip link set "$tun_name" down 2>/dev/null
    ip tuntap del mode tun name "$tun_name" 2>/dev/null
}

reload_service() {
    log "Reloading service..."
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger "$CONF"
    procd_add_interface_trigger "interface.*.up" wan /etc/init.d/$CONF reload
}