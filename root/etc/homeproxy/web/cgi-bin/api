#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
#
# HomeProxy web UI backend (CGI). Served by a standalone uhttpd instance
# (init.d/homeproxy-web) bound to the LAN interface -- no authentication.
#
# Endpoints (action= in the query string; value in the POST body for writes):
#   state              current settings + running flag + sing-box version
#   config             raw ubus uci get JSON (full homeproxy config)
#   set_main_node      body=node        -> set + restart
#   set_routing_mode   body=mode        -> set + restart
#   set_lan_proxy     body=mode        -> set control.lan_proxy_mode + restart
#   get_domain_lists                   -> {direct,proxy} domain lists
#   set_direct_list   body=domains     -> overwrite direct_list.txt + restart
#   set_proxy_list   body=domains     -> overwrite proxy_list.txt + restart
#   subscribe          -> update subscriptions + restart
#   restart            -> /etc/init.d/homeproxy restart
#   log                -> last N lines of the log (lines=, default 80)
#   ping_nodes         -> per-node TCP/HTTP delay (ms) via sing-box Clash API
#   connectivity        -> Google (overseas, via proxy) + Baidu (CN) reachability & ms

set -u
[ -f /etc/homeproxy/env.sh ] && . /etc/homeproxy/env.sh || true
HP_LIB_DIR="${HP_LIB_DIR:-/usr/lib/homeproxy}"
HP_RES_DIR="${HP_RES_DIR:-/etc/homeproxy/resources}"
HP_BIN_DIR="${HP_BIN_DIR:-/usr/bin}"
HP_SINGBOX="${HP_SINGBOX:-$(command -v sing-box 2>/dev/null)}"
HP_SINGBOX="${HP_SINGBOX:-/usr/bin/sing-box}"
export PATH=/usr/bin:/bin:/usr/sbin:/sbin:"${HP_SINGBOX%/*}":"$HP_BIN_DIR"
CONF=homeproxy
RUN_DIR=/var/run/homeproxy
LOG_PATH=$RUN_DIR/$CONF.log
INIT=/etc/init.d/$CONF
SINGBOX="$HP_SINGBOX"

# --- helpers ---------------------------------------------------------------
hdr() { printf '%s\r\n\r\n' "$1"; }
json_ok()  { hdr 'Content-Type: application/json'; printf '%s\n' "$1"; }
json_err() { hdr 'Content-Type: application/json'; printf '{"ok":false,"error":"%s"}\n' "$1"; exit 0; }
text_out() { hdr 'Content-Type: text/plain; charset=utf-8'; printf '%s' "$1"; }

# escape a string for a JSON double-quoted value (newlines -> \n)
jesc() {
	# Strip all control chars except \t (0x09) and \n (0x0a) to keep
	# the output valid JSON; \r (0x0d) is in the \013-\037 range.
	printf '%s' "$1" | tr -d '\000-\010\013-\037\177' | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/	/\\t/g' \
		| awk '{printf "%s%s",sep,$0; sep="\\n"} END{print ""}'
}

# parse ?action=...&lines=...
Q_action=""; Q_lines="80"
for kv in $(printf '%s' "${QUERY_STRING:-}" | tr '&' ' '); do
	case "$kv" in
		action=*) Q_action=${kv#action=} ;;
		lines=*)  Q_lines=${kv#lines=} ;;
	esac
done
case "$Q_lines" in *[!0-9]*) Q_lines=80 ;; esac

read_body() {
	local n="${CONTENT_LENGTH:-0}"
	case "$n" in *[!0-9]*) n=0 ;; esac
	[ "$n" -gt 0 ] 2>/dev/null && head -c "$n" 2>/dev/null || true
}

valid_mode() {
	case "$1" in
		bypass_mainland_china|global|gfwlist|proxy_mainland_china|custom) return 0 ;;
		*) return 1 ;;
	esac
}

# restart the PROXY only (the web UI init is separate, so this never kills uhttpd)
do_restart() { "$INIT" restart >/dev/null 2>&1 || "$INIT" start >/dev/null 2>&1; }

# Write endpoints require POST -- this is an unauthenticated LAN API, so
# guard against an accidental GET clearing a list or triggering a restart.
case "$Q_action" in
	set_main_node|set_routing_mode|set_lan_proxy|set_direct_list|set_proxy_list|set_subscription_urls|set_dns|subscribe|restart)
		[ "${REQUEST_METHOD:-POST}" = "POST" ] || json_err "POST required (got ${REQUEST_METHOD:-none})" ;;
esac

# --- endpoints -------------------------------------------------------------
case "$Q_action" in

state)
	running=false
	pgrep -f "sing-box run --config $RUN_DIR/sing-box" >/dev/null 2>&1 && running=true
	version=$("$SINGBOX" version -n 2>/dev/null | awk 'NR==1{print $NF}')
	[ -z "$version" ] && version="unknown"
	main_node=$(uci -q get $CONF.config.main_node 2>/dev/null); main_node=${main_node:-nil}
	routing_mode=$(uci -q get $CONF.config.routing_mode 2>/dev/null); routing_mode=${routing_mode:-bypass_mainland_china}
	proxy_mode=$(uci -q get $CONF.config.proxy_mode 2>/dev/null); proxy_mode=${proxy_mode:-redirect_tproxy}
	lan_proxy=$(uci -q get $CONF.control.lan_proxy_mode 2>/dev/null); lan_proxy=${lan_proxy:-disabled}
	json_ok "$(printf '{"ok":true,"running":%s,"version":"%s","main_node":"%s","routing_mode":"%s","proxy_mode":"%s","lan_proxy_mode":"%s"}' \
		"$running" "$(jesc "$version")" "$(jesc "$main_node")" "$(jesc "$routing_mode")" "$(jesc "$proxy_mode")" "$(jesc "$lan_proxy")")"
	;;

config)
	out=$(ubus call uci get "{\"config\":\"$CONF\"}" 2>/dev/null)
	[ -n "$out" ] || json_err "ubus uci get failed"
	hdr 'Content-Type: application/json'; printf '%s\n' "$out"
	;;

set_main_node)
	body=$(read_body | tr -d '\r\n')
	body=${body#node=}
	case "$body" in
		nil|urltest) : ;;
		"") json_err "missing node" ;;
		*)
			sec_type=$(uci -q show "$CONF.$body" 2>/dev/null | awk -F= 'NR==1{print $2}'); [ "$sec_type" = "node" ] || json_err "no such node: $body"
			;;
	esac
	uci set $CONF.config.main_node="$body" 2>/dev/null || json_err "uci set failed"
	uci commit $CONF 2>/dev/null || json_err "uci commit failed"
	do_restart
	json_ok '{"ok":true,"main_node":"'"$(jesc "$body")"'"}'
	;;

set_routing_mode)
	body=$(read_body | tr -d '\r\n')
	body=${body#mode=}
	valid_mode "$body" || json_err "bad routing_mode: $body"
	uci set $CONF.config.routing_mode="$body" 2>/dev/null || json_err "uci set failed"
	uci commit $CONF 2>/dev/null || json_err "uci commit failed"
	do_restart
	json_ok '{"ok":true,"routing_mode":"'"$(jesc "$body")"'"}'
	;;

set_lan_proxy)
	body=$(read_body | tr -d '\r\n')
	body=${body#mode=}
	case "$body" in
		disabled|only_proxy|listed_only|except_listed) : ;;
		*) json_err "bad lan_proxy_mode: $body" ;;
	esac
	uci set $CONF.control.lan_proxy_mode="$body" 2>/dev/null || json_err "uci set failed"
	uci commit $CONF 2>/dev/null || json_err "uci commit failed"
	do_restart
	json_ok '{"ok":true,"lan_proxy_mode":"'"$(jesc "$body")"'"}'
	;;

get_domain_lists)
	RES_DIR="$HP_RES_DIR"
	d=$(cat "$RES_DIR/direct_list.txt" 2>/dev/null)
	x=$(cat "$RES_DIR/proxy_list.txt" 2>/dev/null)
	hdr 'Content-Type: application/json'
	printf '{"ok":true,"direct":"%s","proxy":"%s"}\n' "$(jesc "$d")" "$(jesc "$x")"
	;;

set_direct_list|set_proxy_list)
	case "$Q_action" in
		set_direct_list) file=direct_list.txt ;;
		set_proxy_list)  file=proxy_list.txt ;;
	esac
	RES_DIR="$HP_RES_DIR"
	mkdir -p "$RES_DIR" 2>/dev/null
	# sanitize the body (CRLF -> LF, trim each line). Keep comments; drop
	# blank lines. Reject any non-comment line that is not a plain domain
	# ([A-Za-z0-9._-]+): a '/' or whitespace would break dnsmasq server=/
	# ipset= delimiters and take DNS down silently. Empty body clears the list.
	tmp=$(mktemp 2>/dev/null) || tmp="$RUN_DIR/.list.$$"
	badf="${tmp}.bad"
	# tr strips CR above; \r in the class is defense-in-depth.
	read_body | tr -d '\r' | awk -v bad="$badf" '{ sub(/^[ \t\r]+/,""); sub(/[ \t\r]+$/,"") } !NF { next } /^#/ { print; next } $0 !~ /^[A-Za-z0-9._-]+$/ { print > bad; next } { print }' > "$tmp"
	if [ -s "$badf" ]; then
		msg=$(tr "\n" "," < "$badf" | sed "s/,$//; s/[^A-Za-z0-9._,-]/?/g")
		rm -f "$tmp" "$badf"
		json_err "invalid domain line(s): $msg"
	fi
	rm -f "$badf"
	mv -f "$tmp" "$RES_DIR/$file" 2>/dev/null || { rm -f "$tmp"; json_err "write failed"; }
	do_restart
	json_ok '{"ok":true,"file":"'"$file"'"}'
	;;

set_subscription_urls)
	# Replace the subscription_url UCI list from a newline-separated
	# body.  Two-pass: validate-all-then-save so a single bad line
	# does not wipe the existing list.  Must start with http(s):// or
	# sip008:// — same scheme check as update_subscriptions.lua.
	tmp=$(mktemp 2>/dev/null) || tmp="$RUN_DIR/.suburls.$$"
	read_body >"$tmp"
	bad=""
	while IFS= read -r line; do
		line=$(printf '%s' "$line" | sed 's/^[ \t\r]*//;s/[ \t\r]*$//')
		[ -z "$line" ] && continue
		case "$line" in
			https://*|http://*|sip008://*) : ;;
			*) bad="${bad:+$bad,}$(printf '%s' "$line" | sed 's/[^A-Za-z0-9._:/?=&%~-]/?/g')" ;;
		esac
	done <"$tmp"
	if [ -n "$bad" ]; then
		rm -f "$tmp"
		json_err "invalid URL(s): $bad (must start with http(s):// or sip008://)"
	fi
	uci -q delete $CONF.subscription.subscription_url 2>/dev/null
	cnt=0
	while IFS= read -r line; do
		line=$(printf '%s' "$line" | sed 's/^[ \t\r]*//;s/[ \t\r]*$//')
		[ -z "$line" ] && continue
		uci add_list $CONF.subscription.subscription_url="$line"
		cnt=$((cnt+1))
	done <"$tmp"
	rm -f "$tmp"
	uci commit $CONF 2>/dev/null || json_err "uci commit failed"
	json_ok "{\"ok\":true,\"count\":$cnt}"
	;;

set_dns)
	# Set proxy DNS (DoH) and China DNS servers.
	# Body: two lines -- proxy_dns on line 1, china_dns on line 2.
	# proxy_dns: IP or https://host/path (DoH via tunnel)
	# china_dns:  IP only (UDP, direct)
	tmp=$(mktemp 2>/dev/null) || tmp="$RUN_DIR/.dns.$$"
	read_body >"$tmp"
	proxy_dns=$(sed -n '1p' "$tmp" | tr -d '\r')
	china_dns=$(sed -n '2p' "$tmp" | tr -d '\r')
	# Trim whitespace
	proxy_dns=$(printf '%s' "$proxy_dns" | sed 's/^[ \t]*//;s/[ \t]*$//')
	china_dns=$(printf '%s' "$china_dns" | sed 's/^[ \t]*//;s/[ \t]*$//')
	rm -f "$tmp"
	# Validate proxy_dns: must be an IP or https:// URL
	case "$proxy_dns" in
		https://*) : ;;
		"") json_err "proxy DNS is required" ;;
		*)
			# Bare IP — validate it looks like an IPv4/IPv6 address
			case "$proxy_dns" in
				*:*|*.*.*) : ;;
				*) json_err "proxy DNS must be an IP or https:// URL (got: $proxy_dns)" ;;
			esac
			;;
	esac
	# Validate china_dns: must be a plain IP address
	case "$china_dns" in
		"") json_err "china DNS is required" ;;
		*:*|*.*.*) : ;;
		*) json_err "china DNS must be an IP address (got: $china_dns)" ;;
	esac
	uci set $CONF.config.dns_server="$proxy_dns" 2>/dev/null || json_err "uci set failed"
	uci set $CONF.config.china_dns_server="$china_dns" 2>/dev/null || json_err "uci set failed"
	uci commit $CONF 2>/dev/null || json_err "uci commit failed"
	do_restart
	json_ok "{\"ok\":true,\"proxy_dns\":\"$(jesc "$proxy_dns")\",\"china_dns\":\"$(jesc "$china_dns")\"}"
	;;

ping_nodes)
	# Per-node delay (ms) via the sing-box Clash API (loopback 127.0.0.1:19290).
	# Requires generate_client.lua experimental.clash_api + a restart. Tests a
	# real HTTP round-trip through each node outbound -- not a raw TCP ping --
	# because the router's own OUTPUT is NAT-redirected into sing-box.
	api=http://127.0.0.1:19290
	curl -sf --max-time 2 "$api/version" >/dev/null 2>&1 || json_err "clash api not reachable (run: homeproxy generate && homeproxy restart)"
	test_url=http://www.gstatic.com/generate_204
	tmp=$(mktemp -d 2>/dev/null) || tmp=/tmp/hp_ping.$$ ; mkdir -p "$tmp" 2>/dev/null
	for sect in $(uci -q show $CONF 2>/dev/null | sed -n 's/^homeproxy\.\([^.]*\)=node$/\1/p'); do
		tag=cfg-$sect-out
		( curl -s --max-time 8 "$api/proxies/$tag/delay?url=$test_url&timeout=5000" -o "$tmp/$sect" 2>/dev/null; echo $? >"$tmp/$sect.rc" ) &
	done
	wait
	first=1
	hdr 'Content-Type: application/json'
	printf '{"ok":true,"results":{'
	for sect in $(uci -q show $CONF 2>/dev/null | sed -n 's/^homeproxy\.\([^.]*\)=node$/\1/p'); do
		[ "$first" -eq 0 ] && printf ','
		first=0
		d=$(cat "$tmp/$sect" 2>/dev/null)
		ms=$(printf '%s' "$d" 2>/dev/null | sed -n 's/.*"delay":[[:space:]]*\([0-9][0-9]*\).*/\1/p')
		[ -n "$ms" ] || ms=null
		printf '"%s":%s' "$sect" "$ms"
	done
	printf '}}\n'
	rm -rf "$tmp" 2>/dev/null
	;;

connectivity)
	# Reachability + round-trip latency for an overseas site (Google) and a CN
	# site (Baidu). The router's own OUTPUT is NAT-redirected for non-CN dst,
	# so Google is exercised THROUGH sing-box while Baidu (CN ipset RETURN) goes
	# direct in bypass mode -- no firewall changes needed. Uses time to first
	# byte (starttransfer) so Baidu's body size does not skew the latency.
	tmp=$(mktemp -d 2>/dev/null) || tmp=/tmp/hp_conn.$$ ; mkdir -p "$tmp" 2>/dev/null
	( curl -s -o /dev/null --max-time 8 -w '%{http_code} %{time_starttransfer}' "http://www.google.com/generate_204" >"$tmp/google" 2>/dev/null; echo $? >"$tmp/google.rc" ) &
	( curl -s -o /dev/null --max-time 8 -w '%{http_code} %{time_starttransfer}' "http://www.baidu.com/" >"$tmp/baidu" 2>/dev/null; echo $? >"$tmp/baidu.rc" ) &
	wait
	conn_ms() {
		# $1=file -> print "<true|false> <code> <ms|null>"
		local raw code t ok ms
		raw=$(cat "$tmp/$1" 2>/dev/null)
		code=$(printf '%s' "$raw" | awk '{print $1}')
		t=$(printf '%s' "$raw" | awk '{print $2}')
		ok=false
		case "$code" in [23]??) ok=true ;; esac
		if [ "$ok" = "true" ] && [ -n "$t" ]; then
			ms=$(awk -v x="$t" 'BEGIN{printf "%d",(x+0)*1000}')
		else
			ms=null
		fi
		printf '%s %s %s' "$ok" "${code:-000}" "$ms"
	}
	set -- $(conn_ms google); g_ok=$1; g_code=$2; g_ms=$3
	set -- $(conn_ms baidu);  b_ok=$1; b_code=$2; b_ms=$3
	hdr 'Content-Type: application/json'
	printf '{"ok":true,"google":{"ok":%s,"code":"%s","ms":%s},"baidu":{"ok":%s,"code":"%s","ms":%s}}\n' \
		"$g_ok" "$g_code" "$g_ms" "$b_ok" "$b_code" "$b_ms"
	rm -rf "$tmp" 2>/dev/null
	;;

subscribe)
	tmp=$(mktemp 2>/dev/null || echo /tmp/hp_sub.$$.log)
	if HP_LUAPATH="$HP_LIB_DIR" lua "$HP_LIB_DIR/update_subscriptions.lua" >"$tmp" 2>&1; then
		uci commit $CONF 2>/dev/null
		do_restart
		tail -n 20 "$tmp" 2>/dev/null > "$tmp.short"
		hdr 'Content-Type: application/json'
		printf '{"ok":true,"output":"%s"}\n' "$(jesc "$(cat "$tmp.short" 2>/dev/null)")"
	else
		rc=$?
		hdr 'Content-Type: application/json'
		printf '{"ok":false,"error":"subscription update failed (rc=%s)","output":"%s"}\n' "$rc" "$(jesc "$(tail -n 20 "$tmp" 2>/dev/null)")"
	fi
	rm -f "$tmp" "$tmp.short" 2>/dev/null
	;;

restart)
	do_restart
	json_ok '{"ok":true,"restarted":true}'
	;;

log)
	n="$Q_lines"
	text_out "$(tail -n "$n" "$LOG_PATH" 2>/dev/null || echo '(no log yet)')"
	;;

""|help)
	text_out "HomeProxy API. actions: state config set_main_node set_routing_mode set_lan_proxy get_domain_lists set_direct_list set_proxy_list set_subscription_urls set_dns ping_nodes connectivity subscribe restart log"
	;;

*)
	json_err "unknown action: $Q_action"
	;;
esac
